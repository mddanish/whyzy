# Copy to .env.local and fill in. Never commit .env.local.
# In Vercel, set the runtime ones under Project > Settings > Environment Variables.

# Turso Platform API (setup scripts and Phase 2 family DB creation)
TURSO_API_TOKEN=
TURSO_ORG=
# TURSO_LOCATION=aws-ap-south-1

# Central DB (from the Turso dashboard, or written by `npm run turso:setup`)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Development and tests only: keep family DBs as local SQLite files here
# instead of creating Turso databases.
# FAMILY_DB_LOCAL_DIR=.data/families

# Auth.js: random 32+ byte secret (`npx auth secret` or `openssl rand -base64 32`)
AUTH_SECRET=

# AI Gateway. On Vercel, auth uses the project's OIDC token automatically.
# Locally: run `vercel env pull` or set AI_GATEWAY_API_KEY.
# AI_GATEWAY_API_KEY=
# The one place the chat model is named. Switch for the pilot (see OPERATOR_TODO.md).
WHYZY_MODEL=nvidia/nemotron-3.5-lightning-free
# test | pilot. Pilot blocks free models and forces no-training + zero retention.
WHYZY_STAGE=test

# Vercel CLI deploys
VERCEL_TOKEN=

# Data hygiene: no Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
