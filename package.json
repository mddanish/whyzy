{
  "name": "whyzy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.family.config.ts && drizzle-kit generate --config drizzle.content.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate-central.ts",
    "turso:setup": "tsx --env-file-if-exists=.env.local scripts/turso-setup.ts",
    "keys:create": "tsx --env-file-if-exists=.env.local scripts/create-access-keys.ts",
    "redteam:live": "tsx --env-file-if-exists=.env.local scripts/redteam-live.ts",
    "content:migrate": "tsx --env-file-if-exists=.env.local scripts/content-migrate.ts",
    "content:seed": "tsx --env-file-if-exists=.env.local scripts/content-seed.ts",
    "content:validate": "tsx --env-file-if-exists=.env.local scripts/content-validate.ts",
    "content:generate": "tsx --env-file-if-exists=.env.local scripts/content-generate.ts",
    "content:narrate": "tsx --env-file-if-exists=.env.local scripts/content-narrate.ts",
    "models:free": "tsx --env-file-if-exists=.env.local scripts/models-free.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.163",
    "@auth/drizzle-adapter": "^1.11.3",
    "@libsql/client": "^0.18.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@vercel/connect": "^2.7.0",
    "ai": "^7.0.159",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
